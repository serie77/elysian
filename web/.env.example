# Set these in the Vercel project (Settings, Environment Variables), then redeploy.

# Public URL of the Elysian node (indexer, relayer, executor). Must be https. The node cannot run on Vercel.
NEXT_PUBLIC_NODE_URL=https://node.example.com
# Alchemy key for Robinhood Chain. Server side only: used by /api/rpc and /api/transfers.
ALCHEMY_KEY=
# Contract address of the Elysian token, shown in the copy box on the landing page. Empty until launch.
NEXT_PUBLIC_TOKEN_CA=
# Public origin of the site, used for absolute link-preview URLs (og:image). No trailing slash.
NEXT_PUBLIC_SITE_URL=https://www.elysianprotocol.org
