# Copy to .env at the repo root. The contracts, the node and the web app all read it. Never commit the real file.

# Alchemy key for Robinhood Chain. Server side only; without it the public RPC is used.
ALCHEMY_KEY=

# web: contract address of the Elysian token, shown in the copy box on the landing page. Empty until launch.
NEXT_PUBLIC_TOKEN_CA=

# contracts: deploy:testnet / deploy:mainnet
DEPLOYER_KEY=
# Address allowed to clear batches; defaults to the deployer
EXECUTOR=
BATCH_DURATION=60

# node: which deployment to serve. RPC_URL overrides the default for that chain.
DEPLOYMENT=localhost
PORT=8787
RELAYER_KEY=
EXECUTOR_KEY=
RELAY_FEE_BPS=10
SLIPPAGE_BPS=50
